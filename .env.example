# ===================
# SIP Configuration
# ===================
SIP_USER=ai-assistant
SIP_PASSWORD=
SIP_DOMAIN=localhost
SIP_PORT=5060
SIP_TRANSPORT=udp
# SIP_REGISTRAR=sip:your-registrar.example.com

# ===================
# Audio Configuration
# ===================
# Speech detection timing
MIN_SPEECH_DURATION_MS=200
MAX_SPEECH_DURATION_S=10.0
SILENCE_TIMEOUT_MS=750

# Endpointing: how end-of-utterance silence is chosen.
#   fixed       - always SILENCE_TIMEOUT_MS (default, today's behavior)
#   adaptive    - per-chunk timeout scaled between ENDPOINT_MIN/MAX_SILENCE_MS
#                 from how long the caller has been speaking
#   speculative - end the utterance at ENDPOINT_MIN_SILENCE_MS; transcripts
#                 that don't read as a finished thought are held and merged
#                 with follow-up speech, up to ENDPOINT_MAX_SILENCE_MS
ENDPOINT_MODE=fixed
ENDPOINT_MIN_SILENCE_MS=350
ENDPOINT_MAX_SILENCE_MS=1500

# Barge-in settings
# BARGE_IN_MIN_DURATION - how long the caller must talk over the assistant
#   before it stops speaking.
# BARGE_IN_MAX_GAP_MS   - gap of VAD-negative audio tolerated INSIDE that run.
#   Real speech isn't VAD-positive end to end (gaps between syllables, unvoiced
#   consonants), so without a tolerance the run resets on the first negative
#   chunk and the caller has to talk for several times BARGE_IN_MIN_DURATION.
#   Keep it well under SILENCE_TIMEOUT_MS: it bridges gaps, it doesn't end turns.
BARGE_IN_MIN_DURATION=400
BARGE_IN_MAX_GAP_MS=250
BARGE_IN_ENERGY_THRESHOLD=2000

# ===================
# Speaches API (Unified STT + TTS)
# ===================
SPEACHES_API_URL=http://localhost:8001

# STT Mode: "realtime" (WebSocket streaming) or "batch" (file upload)
# NOTE: Realtime mode requires Speaches v0.8.0+ with stable realtime API.
# Default to batch mode for stability. Realtime may have lower latency but is less stable.
STT_MODE=batch
# Seconds to wait for a transcript after committing the realtime audio buffer
# (realtime mode only).
REALTIME_COMMIT_TIMEOUT_S=5.0

# Whisper model for STT
WHISPER_MODEL=Systran/faster-distil-whisper-small.en
WHISPER_LANGUAGE=en

# TTS settings (Piper/Kokoro via Speaches)
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
TTS_RESPONSE_FORMAT=wav
TTS_SPEED=1.0
# Stream long responses sentence-by-sentence (first sentence plays while the
# rest synthesize). Set false to synthesize whole responses in one call.
TTS_SENTENCE_STREAMING=true

# ===================
# API Retry Configuration
# ===================
API_RETRY_ATTEMPTS=3
API_RETRY_BASE_DELAY_S=0.5
API_RETRY_MAX_DELAY_S=5.0
API_TIMEOUT_S=30.0

# ===================
# LLM Configuration
# ===================
# vllm (default) | ollama | lmstudio | langgraph
# "langgraph" enables the agentic engine: a LangGraph ReAct loop that can
# chain several tool calls in one turn. Best with LLM_TOOL_CALLING=native
# and a vLLM started with tool-call parsing (see VLLM_TOOL_ARGS below).
LLM_BACKEND=vllm
# Qwen3-30B-A3B is a MoE with only ~3B active params -> fast decode on
# bandwidth-bound hardware (e.g. DGX Spark / GB10). Use the Instruct-2507
# (non-thinking) variant so no <think> traces leak into spoken replies.
# FP8 halves bytes-per-token; drop the "-FP8" suffix if your server can't serve it.
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=not-needed
# Tool-calling mode: "text" parses [TOOL:...] markers (works with any model);
# "native" uses the OpenAI tools API (needs a model/backend that supports it).
LLM_TOOL_CALLING=text

# Stream LLM tokens straight into sentence-by-sentence TTS: first audio after
# roughly the first sentence's tokens + one TTS call instead of the full
# completion. Live-data questions (weather/time/quakes/...) whose tools are
# loaded still take the non-streaming path so the grounding retry works.
# Requires TTS_SENTENCE_STREAMING=true (whole-text TTS never token-streams).
LLM_STREAMING=true

# Generation parameters
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.85
MAX_CONVERSATION_TURNS=10

# Tool-call round trips allowed per turn (native loop + langgraph agent).
LLM_MAX_TOOL_ROUNDS=5
# Wall-clock cap on one whole agentic turn (langgraph engine only).
LLM_AGENT_TIMEOUT_S=30.0

# Extra args appended to the vLLM server command. The default enables native
# tool-call parsing with the "hermes" parser (correct for the default Qwen3
# model). Set to match your model — e.g. for openai/gpt-oss-*:
#   VLLM_TOOL_ARGS=--enable-auto-tool-choice --tool-call-parser openai
# Set empty (VLLM_TOOL_ARGS=) to disable tool-call parsing entirely.
# VLLM_TOOL_ARGS=--enable-auto-tool-choice --tool-call-parser hermes

# ===================
# Conversation intelligence
# ===================
# Cross-call caller memory: after each call the LLM distills durable facts
# about the caller (name, preferences, open items) into
# data/caller_memory/<caller>.json and recalls them on their next call.
# Fail-open and engine-independent.
CALLER_MEMORY_ENABLED=true
CALLER_MEMORY_MAX_FACTS=15
CALLER_MEMORY_MAX_CHARS=1500
CALLER_MEMORY_TIMEOUT_S=30.0

# Persona/demeanor tool (PERSONA): let the caller set the agent's speaking
# style for the current call ("act like a formal butler") and save/recall
# named demeanor profiles across calls, stored in data/personas.json.
ENABLE_PERSONA_TOOL=true

# Knowledge base (RAG): drop .txt/.md files into data/knowledge/ and the
# agent can look them up with the KNOWLEDGE tool (indexed at startup with
# local CPU embeddings; restart after changing documents). No-ops while the
# directory is empty.
KNOWLEDGE_ENABLED=true
# KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# KNOWLEDGE_CHUNK_SIZE=800
# KNOWLEDGE_CHUNK_OVERLAP=120
# KNOWLEDGE_TOP_K=3
# Also retrieve against every user utterance and inject the top chunks into
# the system prompt (no extra LLM round; adds prompt tokens every turn).
KNOWLEDGE_AUTO_INJECT=false

# Rolling conversation summary: when a call outgrows MAX_CONVERSATION_TURNS,
# older turns are folded into a running summary (background task) instead of
# being silently dropped.
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_TIMEOUT_S=20.0

# ===================
# Tools Configuration
# ===================
# Callback settings
CALLBACK_RING_TIMEOUT=30

# Auto-discover extra tools from plugins/ and data/plugins (mounted volume)
# in addition to the built-in tool set.
ENABLE_PLUGIN_AUTODISCOVERY=true

# Home coordinates for the NWS WEATHER (current conditions) and FORECAST
# tools, and QUAKES "near me" filtering. Empty disables those.
# Example: 39.7392 / -104.9903
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# WEB_SEARCH tool: URL of a SearxNG instance. The compose files ship one
# behind a profile: `docker compose --profile search up -d` then set
# SEARXNG_URL=http://searxng:8080
SEARXNG_URL=
WEB_SEARCH_MAX_RESULTS=3

# GPU_STATUS / ALERTS tools query the observability stack (start it with
# docker-compose.observability.yml). ALERTS prefers Alertmanager when set,
# otherwise reads firing alerts from Prometheus.
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=

# CONTAINER_CTL tool: voice-controlled `docker restart`/status for EXACTLY the
# comma-separated container names listed here. Empty disables the tool.
# Requires uncommenting the /var/run/docker.sock mount on the sip-agent
# service in the compose file. WARNING: the docker socket is root-equivalent
# on the host — enable deliberately and keep this list tight.
CONTAINER_CTL_ALLOWLIST=

# TRANSFER tool: blind-transfer callers to another extension (SIP REFER).
# Targets follow the same OUTBOUND_* dial policy below.
ENABLE_TRANSFER_TOOL=true

# ===================
# REST API security & limits
# ===================
# Shared secret required on all mutating endpoints (POST /call, /tools/*/call,
# /tools/*/execute, /webhook/call, /speak, /schedule). Send as
# `Authorization: Bearer <token>` or `X-API-Key: <token>`. Empty = open (dev only).
API_AUTH_TOKEN=
# Host interface the compose stack publishes the API port on. The default
# 127.0.0.1 keeps the API reachable only from this machine (and other
# containers on the compose network), so an empty API_AUTH_TOKEN works out of
# the box. To expose the API on the network, set API_BIND_ADDRESS=0.0.0.0 AND
# set API_AUTH_TOKEN — the agent refuses to start exposed without a token
# (override with ALLOW_UNAUTHENTICATED=true, not recommended).
API_BIND_ADDRESS=127.0.0.1
# Interface the REST API binds to *inside the container/process*. Must stay
# 0.0.0.0 under Docker for the published port to work; when running the agent
# directly (outside Docker) it defaults to 127.0.0.1.
API_HOST=0.0.0.0

# Operator dashboard: a self-contained web UI served at GET /admin (live call
# view, transcripts, dial/speak, tools, schedules, virtual numbers). The page
# itself is a static shell; every data endpoint it calls honors API_AUTH_TOKEN.
# Set false to remove the page entirely (404).
ADMIN_UI_ENABLED=true

# SSRF guard for callback_url webhooks. When false, callback URLs resolving to
# private/loopback/link-local addresses are rejected.
# NOTE: n8n choice callbacks (callback_url=http://n8n:5678/...) require
# WEBHOOK_ALLOW_PRIVATE=true because the URL resolves to a private
# bridge-network address.
WEBHOOK_ALLOW_PRIVATE=false
# Require https:// callback URLs (default allows http + https).
WEBHOOK_REQUIRE_HTTPS=false
# Optional HMAC-SHA256 secret for outgoing webhooks. When set, each webhook
# POST carries X-Timestamp and X-Signature: sha256=<HMAC(secret,
# "<timestamp>.<body>")> so receivers can verify authenticity.
WEBHOOK_SIGNING_SECRET=

# Call-lifecycle event webhook. When set, the agent POSTs a signed JSON event
# to this URL whenever a call starts/ends (inbound or outbound):
#   {"event":"call.started"|"call.ended","call_id":...,"direction":...,...}
# call.ended additionally carries duration_seconds and (by default) the full
# transcript. Signed with WEBHOOK_SIGNING_SECRET like all other webhooks.
# n8n trigger URLs (http://n8n:5678/webhook/<uuid>/webhook) require
# WEBHOOK_ALLOW_PRIVATE=true. Empty disables the feature.
CALL_EVENT_WEBHOOK_URL=
# Comma-separated subset of events to emit.
CALL_EVENTS=call.started,call.ended
# Include the finished transcript in call.ended payloads.
CALL_EVENT_INCLUDE_TRANSCRIPT=true

# Outbound dial-target policy. When false, callers cannot supply a raw `sip:` URI
# or an `@domain` in `extension` (calls are built as sip:<extension>@SIP_DOMAIN).
OUTBOUND_ALLOW_SIP_URI=false
# Optional regex extensions must fully match, e.g. ^[0-9]{3,15}$
OUTBOUND_EXTENSION_PATTERN=

# Answering-machine detection for outbound notification calls. When enabled,
# sustained speech right after answer marks machine_answered=true in the
# webhook payload (the message still plays either way).
AMD_ENABLED=false
AMD_WINDOW_S=2.5
AMD_MACHINE_SPEECH_MS=1500

# Rate limiting for mutating endpoints: requests/minute per client (keyed by
# API credential, else client IP). 0 disables. RATE_LIMIT_BURST defaults to
# the per-minute rate.
RATE_LIMIT_RPM=0
RATE_LIMIT_BURST=0

# Per-request bounds / backpressure
MAX_RING_TIMEOUT_S=120
MAX_CHOICE_TIMEOUT_S=120
MAX_CHOICE_REPEAT=5
MAX_QUEUE_DEPTH=1000
MAX_DIRECT_CONCURRENT_CALLS=20

# ===================
# Redis (for call queue)
# ===================
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your-secure-password
# REDIS_SSL=true

# ===================
# Observability
# ===================
LOG_LEVEL=INFO

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=sip-agent
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# ===================
# System
# ===================
DATA_DIR=./data

# ===================
# Voice output
# ===================
# Per-turn acknowledgment before the LLM answer:
#   chime  - short earcon ding, plays instantly from memory (default)
#   phrase - speaks a random PHRASES_THINKING entry (pre-cached)
#   none   - silence until the answer starts
TURN_ACK_MODE=chime
# Earcon loudness, 0.0-1.0 fraction of full scale
# CHIME_VOLUME=0.3

# Hang up deterministically when the caller's whole utterance is a farewell
# ("bye", "okay thanks, goodbye") instead of relying on the LLM's HANGUP tool.
# FAREWELL_HANGUP_ENABLED=true

# "Still thinking" tick: when the LLM answer takes longer than the delay,
# play a soft tick every interval so the caller knows to wait (0 disables).
# THINKING_SOUND_DELAY_S=2.0
# THINKING_SOUND_INTERVAL_S=2.5

# Byte cap for audio files uploaded to POST /play (played into the call).
# PLAY_AUDIO_MAX_BYTES=10485760

# Virtual numbers: ephemeral single-use inbound extensions created via
# POST /virtual-numbers. A call dialed to one is answered with the number's
# purpose as context; the outcome is webhooked and the number cleared.
# Unused numbers expire after the TTL. Requires the PBX/registrar (if any)
# to route the range to the agent; direct SIP dialing works out of the box.
# VIRTUAL_NUMBERS_ENABLED=false
# VIRTUAL_NUMBER_DEFAULT_TTL_S=900
# VIRTUAL_NUMBER_MAX_TTL_S=86400
# VIRTUAL_NUMBER_RANGE=7300-7399
# VIRTUAL_NUMBER_MAX_ACTIVE=50

# MCP client: consume tools from external MCP (Model Context Protocol)
# servers. Servers + mandatory per-server expose (and optional confirm)
# allowlists are declared in MCP_SERVERS_FILE — see data/mcp_servers.json.example.
# Tool calls are bounded by MCP_TOOL_TIMEOUT_S (a caller can't wait 60s).
# MCP_ENABLED=false
# MCP_SERVERS_FILE=data/mcp_servers.json
# MCP_TOOL_TIMEOUT_S=10

# Timezone: TZ sets the container clock (logs, cron-ish comparisons);
# LOCAL_TIMEZONE is what the agent SPEAKS and schedules in (system-prompt
# clock, DATETIME tool default, recurring schedules). Keep them equal.
# TZ=America/Los_Angeles
# LOCAL_TIMEZONE=America/Los_Angeles

# Decline an over-capacity inbound call with 486 Busy instead of evicting a
# live one.
# SIP_BUSY_REJECT=true

# Maximum simultaneous live calls (default 1 = classic single-call behavior).
# 2-3 is realistic on a DGX Spark: concurrent calls contend for the same
# STT/TTS/LLM services, so latency stacks with each added call.
# MAX_CONCURRENT_CALLS=1

# PJSIP stack-level call slots (pjsua uaConfig.maxCalls). Outbound calls and
# just-rejected INVITEs briefly hold slots too, so keep this above
# MAX_CONCURRENT_CALLS; the agent auto-raises it to MAX_CONCURRENT_CALLS + 2
# (with a warning) if set lower.
# SIP_MAX_CALLS=4

# "Never guess": when a live-data question (weather/time/quakes/GPU/alerts/
# search) is answered with zero tool calls, retry once forcing tool use.
# GROUNDING_RETRY_ENABLED=true
# GROUNDING_RETRY_TIMEOUT_S=15.0

# Cocktail/drink recipes via TheCocktailDB (DRINK_RECIPE tool).
# ENABLE_DRINK_TOOL=true

# System prompt override (single line). For multi-line prompts create
# data/system_prompt.txt instead — the file takes precedence over this env
# and is live-editable via the mounted data volume (restart to apply).
# SYSTEM_PROMPT=

# Frequency penalty to curb repetitive phrasing (0 = disabled/omitted)
# LLM_FREQUENCY_PENALTY=0.0

# Max seconds for the opt-in reformat_for_speech LLM rewrite of outbound
# messages (API flag / n8n "Reformat for Speech"); falls back to the original
# text on timeout or failure.
# MESSAGE_REFORMAT_TIMEOUT_S=20.0

# ===================
# Phrases Configuration
# ===================
# Customize the assistant's pre-generated phrases
# Use JSON array format or comma-separated values.
# NOTE: these PHRASES_* env vars are not forwarded by the compose files —
# for the docker stack use a phrases.json file in DATA_DIR (mounted volume).

# Greetings - played when call is answered
# PHRASES_GREETINGS=["Hi, this is General Disarray. What can I do for you?"]

# Goodbyes - played when ending call
# PHRASES_GOODBYES=["Goodbye. Take care.","Bye for now."]

# Thinking - spoken before the answer when TURN_ACK_MODE=phrase
# PHRASES_THINKING=["One sec.","Let me check on that.","Just a moment."]

# Errors - played when speech not understood
# PHRASES_ERRORS=["Sorry, I missed that. Say it again?"]

# Follow-ups - played after completing a task
# PHRASES_FOLLOWUPS=["Anything else I can do?"]

# Extra phrases to pre-cache for faster playback
# PHRASES_PRECACHE=["Hello","Goodbye","Yes","No","Thank you"]
